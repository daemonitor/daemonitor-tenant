{
  "name": "@daemonitor/tenant",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nitro build",
    "dev": "nitro build && wrangler dev",
    "deploy": "nitro build && wrangler deploy",
    "check": "for f in test/*.check.ts; do tsx \"$f\" | grep \"check: ok\" || exit 1; done",
    "dev:issuer": "tsx scripts/dev-issuer.ts",
    "dev:token": "tsx scripts/dev-issuer.ts token"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251101.0",
    "nitropack": "2.13.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "wrangler": "^4.45.0"
  }
}
