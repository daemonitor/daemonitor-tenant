{
  "name": "daemonitor-tenant",
  "main": "worker/index.mjs",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Your tenant's hostname, on a zone in this Cloudflare account. Agents report
  // here and daemonitor.com reads from here.
  // "routes": [{ "pattern": "monitor.example.com", "custom_domain": true }],
  "alias": { "~": "./vendor/frontend" },
  // The monthly archive streams a month of reports through gzip in one alarm.
  "limits": { "cpu_ms": 300000 },
  "durable_objects": {
    "bindings": [{ "name": "FLEET", "class_name": "FleetDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FleetDO"] }],
  "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "daemonitor-tenant-archive" }],
  "vars": {
    // Where alert links point: the app at daemonitor.com.
    "APP_URL": "https://daemonitor.com/app"
  }
}
